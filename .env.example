# Solana mainnet RPC endpoint — needed to read real Meteora pool prices.
# Public endpoint is rate-limited; swap in a dedicated RPC (Helius/Triton/QuickNode) for real use.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded secret key for the trading wallet. Not required in paper-trading mode.
WALLET_SECRET_KEY=

# Meteora DLMM pool address to read prices from (mainnet).
# Find one with: npx tsx src/findPools.ts
POOL_ADDRESS=

# How often to poll pool + CEX prices, in ms.
POLL_INTERVAL_MS=5000

# When true, no transactions are ever sent (currently the only supported mode).
DRY_RUN=true

# CEX reference price (Coinbase spot API): GET {CEX_BASE_URL}/{CEX_PAIR}/spot
CEX_BASE_URL=https://api.coinbase.com/v2/prices
CEX_PAIR=SOL-USD

# Notional size per paper trade, in USD.
TRADE_NOTIONAL_USD=500

# Max allowed slippage passed to Meteora swap quotes, in basis points (100 = 1%).
SLIPPAGE_BPS=50

# Spread must exceed this + ASSUMED_ROUND_TRIP_COST_BPS before a trade signal fires.
ENTRY_THRESHOLD_BPS=25

# Spread must revert to within this many bps of zero before a position is closed early.
EXIT_THRESHOLD_BPS=5

# Modeled cost of a real round trip (Meteora fee + hypothetical CEX taker fee), in bps.
# Kept in the entry threshold so the backtest doesn't "trade" spreads that wouldn't be profitable live.
ASSUMED_ROUND_TRIP_COST_BPS=15

# Force-close a position after this long even if the spread hasn't converged, in ms.
MAX_HOLD_MS=300000

# Where paper trade entries/exits get logged (JSON lines).
TRADE_LOG_PATH=paper-trades.jsonl
