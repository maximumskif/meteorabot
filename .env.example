# Solana mainnet RPC endpoint. Used for on-chain signal confirmation (every candidate,
# on-signal) and for real execution if LIVE_TRADING_ENABLED is on.
# Public endpoint is rate-limited and shared with the world; fine for paper trading, but
# swap in a dedicated RPC before trading real size — the app prints a warning on startup
# if LIVE_TRADING_ENABLED=true and this is still the public default. Free/cheap tiers
# that work fine for this bot's volume: Helius (helius.dev), Triton (triton.one), or
# QuickNode (quicknode.com) — sign up, create a Solana mainnet endpoint, paste its https
# URL here (usually includes an API key in the URL/query string already, so nothing else
# to configure).
RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded secret key for the trading wallet. Not required in paper-trading mode —
# only read if LIVE_TRADING_ENABLED=true. Real funds; keep this out of git (already
# gitignored via .env) and never share it.
WALLET_SECRET_KEY=

# How often to poll each monitored pair's Meteora + Raydium price, in ms.
POLL_INTERVAL_MS=5000

# When true, no transactions are ever sent (currently the only supported mode).
DRY_RUN=true

# Where the scanner (npm run scan-pairs) writes its ranked candidate list, and where
# the live loop (npm start) reads it from.
CANDIDATES_PATH=candidates.json

# Minimum TVL (USD) a pool must have on BOTH Meteora and Raydium to be considered a candidate.
MIN_POOL_TVL_USD=20000

# How often the live loop (npm start / npm run dev) re-runs the scanner in the background
# to refresh CANDIDATES_PATH with current pools/TVL/spreads, in ms. Set to 0 to disable —
# candidates.json then only changes via a manual `npm run scan-pairs`.
SCAN_INTERVAL_MS=21600000

# If a pair's TVL on either venue drops by at least this fraction between two consecutive
# background rescans, it's excluded from live monitoring until the next scan confirms it's
# stable — a cheap proxy for a liquidity pull in progress. Has no effect until the process
# has been through at least one auto-rescan.
TVL_DROP_REJECT_PCT=0.5

# Upper cap on notional size per paper trade, in USD. The actual size used is
# min(TRADE_NOTIONAL_USD, minPoolTvl * TRADE_MAX_POSITION_PCT_OF_TVL / 100), so a thin pool
# gets sized down instead of always eating this full notional's worth of price impact.
TRADE_NOTIONAL_USD=500
TRADE_MAX_POSITION_PCT_OF_TVL=2

# Assumed adverse fill vs quoted mid-price on each leg, in basis points (100 = 1%).
SLIPPAGE_BPS=50

# Spread must exceed this + ASSUMED_ROUND_TRIP_COST_BPS before a trade signal fires.
ENTRY_THRESHOLD_BPS=25

# Additional gate on top of ENTRY_THRESHOLD_BPS: how many standard deviations from a pair's
# own recent mean REST spread the current spread must be (once >=10 ticks of history exist)
# before it's treated as a real dislocation instead of that pair's normal noise. 0 disables
# this gate.
ZSCORE_THRESHOLD=2.0

# Modeled cost of a real two-leg round trip (Meteora fee + Raydium fee + price impact), in bps.
# Kept in the entry threshold so paper trades don't "fire" on spreads that wouldn't be
# profitable live. Revisit once per-pool fee data is wired in — this is a rough estimate.
ASSUMED_ROUND_TRIP_COST_BPS=60

# Minimum time between paper trades on the same pair, in ms — avoids re-triggering on
# noisy consecutive ticks once a signal has fired.
TRADE_COOLDOWN_MS=60000

# Where paper trade fills get logged (JSON lines).
TRADE_LOG_PATH=paper-trades.jsonl

# --- Real execution (real funds) — ALL of the following must be set for a live trade to
# ever be attempted. Paper trading above always runs regardless of these. Before touching
# any of this, run `npm run fork-test` and confirm all three swap paths pass against a
# local fork of real mainnet state — that's the safety gate, not these flags alone. ---

# Master switch. Must be true AND I_UNDERSTAND_REAL_FUNDS_AT_RISK must be true — two
# independent flags on purpose, so one accidental env change can't turn real trading on.
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_REAL_FUNDS_AT_RISK=false

# Comma-separated "BASE/QUOTE" pairKeys allowed to trade live (e.g. "USD1/SOL,SOL/USDC").
# Empty = nothing trades live, regardless of the flags above.
LIVE_PAIR_ALLOWLIST=

# Hard $ cap per live trade. No default — must be set explicitly. Start small (e.g. 5).
LIVE_TRADE_NOTIONAL_USD=0

# Cumulative realized loss (USD) that halts new live trades for the rest of the day.
# No default — must be set explicitly. Persisted to LIVE_DAILY_PNL_STATE_PATH so a
# restart doesn't silently reset it mid-day.
LIVE_DAILY_LOSS_CAP_USD=0

# Refuses a live trade if LIVE_TRADE_NOTIONAL_USD exceeds this % of the smaller pool's TVL.
LIVE_MAX_POSITION_PCT_OF_TVL=1

# Where real fills/rejects/leg-risk events get logged (JSON lines) — separate from the
# paper trade log so the two are never confused.
LIVE_TRADE_LOG_PATH=real-trades.jsonl

# Where today's realized live P&L is persisted, so the daily loss cap survives a
# process restart instead of resetting to $0.
LIVE_DAILY_PNL_STATE_PATH=live-daily-pnl.json

# Optional. Discord channel webhook URL (Channel Settings -> Integrations -> Webhooks ->
# New Webhook -> Copy URL) for real-money alerts: fills, leg failures, leg-risk aborts
# (unhedged position left open), and the daily loss cap being hit. Paper trading never
# alerts here — too high-volume, no real risk. Leave unset to disable; a failed/slow
# webhook post is logged and swallowed, never allowed to block trading logic.
ALERT_DISCORD_WEBHOOK_URL=
